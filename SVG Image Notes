<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <g fill="#1FD200">
    <!-- Bushy tree crown -->
    <circle cx="112" cy="92" r="56" />
    <circle cx="170" cy="66" r="56" />
    <circle cx="222" cy="102" r="50" />
    <circle cx="78" cy="150" r="50" />
    <circle cx="150" cy="140" r="66" />
    <circle cx="218" cy="160" r="44" />
    <!-- Trunk, widening to the ground -->
    <polygon points="132,170 162,170 176,352 100,352" />
    <!-- Picnic table: top, bench, legs -->
    <rect x="252" y="226" width="168" height="26" rx="13" />
    <rect x="226" y="286" width="228" height="24" rx="12" />
  </g>
  <g stroke="#1FD200" stroke-width="24" stroke-linecap="round" fill="none">
    <line x1="296" y1="244" x2="262" y2="346" />
    <line x1="376" y1="244" x2="410" y2="346" />
    <!-- Ground -->
    <line x1="40" y1="356" x2="472" y2="356" />
  </g>
  <!-- POTA, bold white with a black outline, like the SOTA button -->
  <text x="256" y="470" text-anchor="middle" font-family="Arial Black, Arial, Helvetica, sans-serif" font-weight="900"
    font-size="170" textLength="452" lengthAdjust="spacingAndGlyphs"
    fill="#FFFFFF" stroke="#000000" stroke-width="18" stroke-linejoin="round" paint-order="stroke">POTA</text>
</svg>

<!-- SOTA summits: a double peak (the left higher), each snow-capped. The map's three states (grey, then orange), like the
     DX Feeds icons (no rig on the band / a rig on the band / a rig on the band and mode), 64x64, one mountain size and
     map scale for all three; and sota_menu.png, the button panel's SOTA button with SOTA across it like the POTA
     button, 128x128. PNGs in src/renderer/img -->

<!-- sota_menu.png -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Background Container (Deep Tactical Gray/Black), as feed_menu.png -->
  <rect width="512" height="512" rx="40" fill="#101418" stroke="#1A2229" stroke-width="12"/>
  <g transform="translate(36,0) scale(4.4)">
    <!-- Double peak -->
    <polygon points="8,85 40,15 55,45 68,32 92,85" fill="#FF9900" fill-opacity="0.15" />
    <!-- Snow caps -->
    <polygon points="40,15 24.9,48 30,43 35,50 41,42 47,47 55,45" fill="#FFFFFF" />
    <polygon points="68,32 55,45 59,44 63,49 68,45 72,50 76.2,50" fill="#FFFFFF" />
    <!-- Outline over all -->
    <polygon points="8,85 40,15 55,45 68,32 92,85" fill="none" stroke="#FF9900" stroke-width="7" stroke-linejoin="round" />
  </g>
  <!-- SOTA, bold white with a black outline, like the POTA button's lettering -->
  <text x="256" y="470" text-anchor="middle" font-family="Arial Black, Arial, Helvetica, sans-serif" font-weight="900"
    font-size="170" textLength="452" lengthAdjust="spacingAndGlyphs"
    fill="#FFFFFF" stroke="#000000" stroke-width="18" stroke-linejoin="round" paint-order="stroke">SOTA</text>
</svg>

