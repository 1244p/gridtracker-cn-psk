<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 20" width="92" height="80">
  <!-- Drawn on the original 23x20 flag's grid, all of it 2 units left so the pennant's point has room at the right (the
       pole's foot, the map anchor, is at 10,17: 40,68 in the PNG) -->
